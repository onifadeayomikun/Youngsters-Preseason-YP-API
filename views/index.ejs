<%- include("partials/header.ejs") %>

<div class="jumbotron centered">
  <div class="container">
    <h1 class="display-3">YPT</h1>
    <p class="lead">Track every youngster the major clubs have taken for preseason</p>
    <hr>
    
    <div>
      <table class="table table-striped table-bordered">
        <thead>
          <tr>
            <th>Club</th>
            <th>Season</th>
            <th><a href="/info/players">Player</a></th>
            <th>Position</th>
            <th>Nationality</th>
            <th>Age</th>
            <th>Appearances</th>
            
          </tr>
        </thead>

        <tbody>
          <% response.forEach((club, index) => { %>
            <% const nextClub = response[index + 1]; %>
            <tr> 
              <% if (nextClub && club.name === nextClub.name) { %>
                <td><%= club.name %></td>
                <td><a href="<%= club.name %>/preseason/<%= club.season_label %>"><%= club.season_label %></a></td>
                <td><%= club.player_name %></td>
                <td><%= club.position %></td>
                <td><%= club.nationality %></td>
                <td><%= club.age %></td>
                <td><%= club.appearances %></td>                
              <% } else { %>
                <td><a href="clubs/<%= club.name %>"><%= club.name %></a></td>
                <td><a href="seasons/<%= club.season_label %>"><%= club.season_label %></a></td>
                <td><a href="players/<%= club.player_name %>"><%= club.player_name %></a></td>
                <td><%= club.position %></td>
                <td><%= club.nationality %></td>
                <td><%= club.age %></td>
                <td><%= club.appearances %></td> 
              <% } %>  
            </tr>  
           

            <% if (nextClub && club.name === nextClub.name && club.season_label !== nextClub.season_label) { %>
              <tr>
                <td colspan="7" style="padding: 0 8px;">
                  <br style="margin: 7px 0;">
                </td>
              </tr>
            <% } %>

            <% if (nextClub && club.name !== nextClub.name) { %>
              <tr>
                <td colspan="7"><br></td>
              </tr>
            <% } %>
          <% }) %>

        </tbody> 
      </table>   
    </div>

  </div>
</div>


<%- include("partials/footer.ejs") %>