<%- include("partials/header.ejs") %>

<div class="jumbotron centered">
  <div class="container">
    <h1 class="display-3"><a href="/info/clubs">YPT</a></h1>
    <div class="container-lead-a">
      <p class="lead">Track every youngster the major clubs have taken for preseason from 2023-24 season</p>
      <% if (locals.showPreseasonPlayerForm) { %>
        <a href="/newplayer" class="leadTag">
          New Player Stat
          <svg class="svgTag" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5v14M5 12h14"/>
          </svg>
        </a>
      <% } %>
    </div>
    <hr>

    <div>
      <table class="table table-striped table-bordered">
        <thead>
          <tr>
            <th><a href="/info/club">Club</a></th>
            <th>Season</th>
            <th><a href="/info/players">Player</a></th>
            <th>Position</th>
            <th>Nationality</th>
            <th>Age</th>
            <th>Appearances</th>
            <% if (locals.showPreseasonPlayerForm) { %>
              <th>Actions</th>
            <% } %>
          </tr>
        </thead>

        <tbody>
          <% response.forEach((club, index) => { %>
            <tr> 
              <td><a href="/info/clubs/<%= club.name %>"><%= club.name %></a></td>

              <% if (!locals.currentPath?.includes(encodeURIComponent(club.name))) { %>
                <td><a href="/info/seasons/<%= club.season_label %>"><%= club.season_label %></a></td>
              <% } else { %>
                <td><a href="/info/clubs/<%= club.name %>/preseason/<%= club.season_label %>"><%= club.season_label %></a></td>
              <% } %>
              
              <td><a href="/info/players/<%= club.player_name %>"><%= club.player_name %></a></td>
              <td><%= club.position %></td>
              <td><%= club.nationality %></td>
              <td><%= club.age %></td>
              <td><%= club.appearances %></td>
              <% if (locals.showPreseasonPlayerForm) { %>
                <td class="text-nowrap">
                  <a
                    href="/modify/clubs/<%= encodeURIComponent(club.name) %>/players/<%= encodeURIComponent(club.player_name) %>/preseason/<%= encodeURIComponent(club.season_label) %>"
                    aria-label="Edit <%= club.player_name %>"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>
                    </svg>
                  </a>
                  <form class="d-inline" method="post" action="/info/clubs/<%= encodeURIComponent(club.name) %>/players/<%= encodeURIComponent(club.player_name) %>/preseason/<%= encodeURIComponent(club.season_label) %>/delete">
                    <button class="btn btn-link p-0 ml-2 align-baseline" type="submit" aria-label="Delete <%= club.player_name %>">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/>
                      </svg>
                    </button>
                  </form>
                </td>
              <% } %>
            </tr>  
           <% const nextClub = response[index + 1]; %>

            <% if (nextClub && club.name === nextClub.name && club.season_label !== nextClub.season_label) { %>
              <tr>
                <td colspan="<%= locals.showPreseasonPlayerForm ? 8 : 7 %>" style="padding: 0 8px;">
                  <hr style="margin: 7px 0;">
                </td>
              </tr>
            <% } %>

            <% if (nextClub && club.name !== nextClub.name) { %>
              <tr>
                <td colspan="<%= locals.showPreseasonPlayerForm ? 8 : 7 %>"><br></td>
              </tr>
            <% } %>
          <% }) %>

        </tbody> 
      </table>   
    </div>

  </div>
  <div class="text-center">
    <a class="d-inline-block btn btn-light btn-lg" href="/logout" role="button">Log Out</a>
  </div>
</div>


<%- include("partials/footer.ejs") %>
