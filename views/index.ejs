<%- include("partials/header.ejs") %>

<div class="jumbotron centered">
  <div class="container">
    <h1 class="display-3"><a href="/info/clubs">YPT</a></h1>
    <p class="lead">Track every youngster the major clubs have taken for preseason</p>
    <hr>
    
    <div>
      <table class="table table-striped table-bordered">
        <thead>
          <tr>
            <th>Club</th>
            <th>Season</th>
            <th><a href="/info/players">Player</a></th>
            <th>Position</th>
            <th>Nationality</th>
            <th>Age</th>
            <th>Appearances</th>
            
          </tr>
        </thead>

        <tbody>
          <% response.forEach((club, index) => { %>
            <tr> 
              <td><a href="/info/clubs/<%= club.name %>"><%= club.name %></a></td>

              <% if (!locals.currentPath?.includes(encodeURIComponent(club.name))) { %>
                <td><a href="/info/seasons/<%= club.season_label %>"><%= club.season_label %></a></td>
              <% } else { %>
                <td><a href="/info/clubs/<%= club.name %>/preseason/<%= club.season_label %>"><%= club.season_label %></a></td>
              <% } %>
              
              <td><a href="/info/players/<%= club.player_name %>"><%= club.player_name %></a></td>
              <td><%= club.position %></td>
              <td><%= club.nationality %></td>
              <td><%= club.age %></td>
              <td><%= club.appearances %></td> 
            </tr>  
           <% const nextClub = response[index + 1]; %>

            <% if (nextClub && club.name === nextClub.name && club.season_label !== nextClub.season_label) { %>
              <tr>
                <td colspan="7" style="padding: 0 8px;">
                  <hr style="margin: 7px 0;">
                </td>
              </tr>
            <% } %>

            <% if (nextClub && club.name !== nextClub.name) { %>
              <tr>
                <td colspan="7"><br></td>
              </tr>
            <% } %>
          <% }) %>

        </tbody> 
      </table>   
    </div>

  </div>
</div>


<%- include("partials/footer.ejs") %>