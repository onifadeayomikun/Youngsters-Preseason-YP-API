<%- include("partials/header.ejs") %>

<div class="jumbotron centered">
  <div class="container">
    <h1 class="display-3"><a href="/info/clubs">YPT</a></h1>
    <p class="lead">Track every youngster the major clubs have taken for preseason</p>
    <hr>
    
    <div class="table-responsive w-75 mx-auto">
      <table class="table table-striped table-bordered">
        <thead>
          <tr>
            <th><a href="/info/players">Player</a></th>
            <th>Position</th>
            <th>Nationality</th>
            
          </tr>
        </thead>

        <tbody>
          <% response.forEach((club) => { %>
            <tr> 
              <td><a href="/info/players/<%= club.player_name %>"><%= club.player_name %></a></td>
              <td><%= club.position %></td>
              <td><%= club.nationality %></td> 
            </tr>  
          <% }) %>

        </tbody> 
      </table>   
    </div>

  </div>
</div>


<%- include("partials/footer.ejs") %>