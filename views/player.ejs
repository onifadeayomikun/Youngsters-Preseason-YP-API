<%- include("partials/header.ejs") %>

<div class="jumbotron centered">
  <div class="container">
    <h1 class="display-3"><a href="/info/clubs">YPT</a></h1>
    <p class="lead">Track every youngster the major clubs have taken for preseason</p>
    <hr>
    
    <div class="table-responsive w-75 mx-auto">
      <table class="table table-striped table-bordered">
        <thead>
          <tr>
            <th><a href="/info/players">Player</a></th>
            <th>Position</th>
            <th>Nationality</th>
            
          </tr>
        </thead>

        <tbody>
          <% response.forEach((club) => { %>
            <tr> 
              <td><a href="/info/players/<%= club.player_name %>"><%= club.player_name %></a></td>
              <td><%= club.position %></td>
              <td><%= club.nationality %></td>
              <td><a href="/modify/<%= club.player_name %>"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                <path d="m15 5 4 4"/>
                </svg></a>
              </td>
              <td><a href="/delete/<%= club.player_name %>"></a><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 6h18"/>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                <line x1="10" y1="11" x2="10" y2="17"/>
                <line x1="14" y1="11" x2="14" y2="17"/>
              </svg></a>
            </td>

            </tr>  
          <% }) %>

        </tbody> 
      </table>   
    </div>

  </div>
</div>


<%- include("partials/footer.ejs") %>