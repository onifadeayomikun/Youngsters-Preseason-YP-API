<%- include("partials/header.ejs") %>
    <div class="jumbotron centered">
        <div class="container">
            <h1 class="display-3"><a href="/info/clubs">YPT</a></h1>
            <p class="lead">Track every youngster the major clubs have taken for preseason</p>
            <hr>

            <% if (locals.club) { %>
                    <form id="editForm" class="form" method="post" action="/modify/<%=club.name%>">
                        <input type="text" name="title" value="<%=club.name%>">
                        <input type="text" name="content" value="<%=club.slang %>">
                        <input type="text" name="type" value="<%=club.country%>">
                        <input type="text" name="author" value="<%=club.city %>">
                        <input type="text" name="author" value="<%=club.seasons_available %>">
                        <button class="full-width" type="submit"> <%= submit %> </button>
                    </form>
            <% } else {%>
                <form id="newForm" class="form" method="post" action="/info/clubs">
                    <input type="text" name="name" placeholder="Club Name" required>
                    <input type="text" name="slang" placeholder="Slang" required>
                    <input type="text" name="country" placeholder="Country" required>
                    <input type="text" name="city" placeholder="City" required>
                    <input type="text" name="seasons_available" placeholder="Seasons Available" required>
                    <button class="full-width" type="submit">  <%= submit %> </button>
                </form>
                <% } %>
        </div>
    </div>
<%- include("partials/footer.ejs") %>