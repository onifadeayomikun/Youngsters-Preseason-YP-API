<%- include("partials/header.ejs") %>
    <div class="jumbotron centered">
        <div class="container">
            <h1 class="display-3"><a href="/info/clubs">YPT</a></h1>
            <p class="lead">Track every youngster the major clubs have taken for preseason</p>
            <hr>

            <% if (locals.club) { %>
                <form id="editForm" class="form" method="post" action="/modify/player/<%=club[0].player_name%>">
                    <input type="text" name="playerName" value="<%=club[0].player_name%>">
                    <input type="text" name="position" value="<%=club[0].position %>">
                    <input type="text" name="nationality" value="<%=club[0].nationality%>">
                    <button class="full-width" type="submit"> <%= submit %> </button>
                </form>
            <% } else {%>
                <form id="newForm" class="form" method="post" action="/info/players">
                    <input type="text" name="playerName" placeholder="Player's Name" required>
                    <input type="text" name="position" placeholder="Position" required>
                    <input type="text" name="nationality" placeholder="Nationality" required>
                    <button class="full-width" type="submit">  <%= submit %> </button>
                </form>
                <% } %>
        </div>
    </div>
<%- include("partials/footer.ejs") %>